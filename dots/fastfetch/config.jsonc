// dynisle: fastfetch on every new terminal (hooked from fish/config.fish).
// The black hole beside it is drawn by dynisle/scripts/blackhole.py in the
// shell's current colours; every other colour here is an ANSI slot, which the
// terminal theme matugen writes fills with the same palette.
{
    "logo": {
        "type": "file-raw",
        "source": "~/.config/fastfetch/blackhole.ansi",
        "width": 44,
        "height": 17,
        "padding": {
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "37",
            "output": "97"
        },
        "bar": {
            "color": {
                "elapsed": "34",
                "total": "2;37"
            },
            "char": {
                "elapsed": "■",
                "total": "·"
            },
            "border": {
                "left": "",
                "right": ""
            },
            "width": 10
        },
        "percent": {
            "type": 11,
            "color": {
                "green": "34",
                "yellow": "33",
                "red": "31"
            }
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{#1;34}{user-name}{#2;37} @ {#1;37}{host-name}"
        },
        {
            "type": "custom",
            "format": "{#2;37}╭─ {#22;34} {#1;34}hardware{#2;37} ───────────────────"
        },
        {
            "type": "host",
            "key": "{#2;37}│ {#22;34}󰌢  {#2;37}machine  ",
            "format": "{name}"
        },
        {
            "type": "cpu",
            "key": "{#2;37}│ {#22;34}󰻠  {#2;37}cpu      ",
            "format": "{name} · {cores-logical} threads"
        },
        {
            "type": "gpu",
            "key": "{#2;37}│ {#22;34}󰢮  {#2;37}gpu      ",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "{#2;37}│ {#22;34}󰍛  {#2;37}memory   ",
            "format": "{percentage-bar} {percentage}  {used} / {total}"
        },
        {
            "type": "disk",
            "key": "{#2;37}│ {#22;34}󰋊  {#2;37}disk     ",
            "folders": "/",
            "format": "{size-percentage-bar} {size-percentage}  {size-used} / {size-total}"
        },
        {
            "type": "battery",
            "key": "{#2;37}│ {#22;34}󰁹  {#2;37}battery  ",
            "format": "{capacity-bar} {capacity}  {status}"
        },
        {
            "type": "custom",
            "format": "{#2;37}├─ {#22;35} {#1;35}software{#2;37} ───────────────────"
        },
        {
            "type": "os",
            "key": "{#2;37}│ {#22;35}  {#2;37}os       ",
            "format": "{pretty-name} {arch}"
        },
        {
            "type": "kernel",
            "key": "{#2;37}│ {#22;35}  {#2;37}kernel   ",
            "format": "{release}"
        },
        {
            "type": "wm",
            "key": "{#2;37}│ {#22;35}  {#2;37}wm       ",
            "format": "{pretty-name} {version}"
        },
        {
            "type": "shell",
            "key": "{#2;37}│ {#22;35}  {#2;37}shell    ",
            "format": "{pretty-name} {version}"
        },
        {
            "type": "terminal",
            "key": "{#2;37}│ {#22;35}  {#2;37}terminal ",
            "format": "{pretty-name} {version}"
        },
        {
            "type": "packages",
            "key": "{#2;37}│ {#22;35}󰏖  {#2;37}packages "
        },
        {
            "type": "uptime",
            "key": "{#2;37}╰ {#22;36}󰅐  {#2;37}uptime   "
        },
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 2
        }
    ]
}
